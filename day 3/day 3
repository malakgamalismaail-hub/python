#day 3 challenge

total=0
avg=0
highest=0
highest_day=0

for i in range(7):
    hours=float(input(f"how many hours did you train on day {i+1}?"))
    while hours<0:
        print("invalid number of hours enter number above 0 or equal 0" )
        hours=float(input(f"how many hours did you train on day {i+1}?"))
    total+=hours
    if hours>=highest:
        highest=hours
        highest_day=i+1

avg=total/7

print(f"total weekly hours={total}")
print(f"average training hour per day {avg:.2f}")
print(f"highest training hours was on {highest_day} = {highest}")

